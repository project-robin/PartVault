{
  "name": "partvault",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b",
    "build": "pnpm --filter @partvault/shared build && pnpm --filter partvault-api build && pnpm --filter partvault-worker build && pnpm --filter partvault-web build",
    "test": "vitest run",
    "openapi": "tsx scripts/gen-openapi.mts",
    "infra:deploy": "pnpm --filter ./infra deploy",
    "infra:destroy": "pnpm --filter ./infra destroy",
    "infra:synth": "pnpm --filter ./infra synth",
    "infra:bootstrap": "pnpm --filter ./infra bootstrap",
    "seed": "tsx scripts/seed.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  }
}
